<?xml version="1.0"?>
<schema name="release-group" version="1.7" xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- link to fieldType definitions for all cores-->
  <xi:include href="common/fieldtypes.xml" />
  <!-- To use the custom similarities (ReleaseSimilarity and AliasSimilarity) found in several
    cores, and since all avaliable field types are linked to each core (for simplicity) we need to
    enable per-field similarity in all cores -->
  <similarity class="solr.SchemaSimilarityFactory" />
  <field name="releasegroup" type="title" indexed="true" stored="true" required="true" />
  <field name="releasegroupaccent" type="title_keep_accents" indexed="true" stored="false" />
  <field name="comment" type="text" indexed="true" stored="true" />

  <field name="arid" type="mbid" indexed="true" stored="false" multiValued="true" />
  <field name="artist" type="text_mult" indexed="true" stored="false" />
  <field name="artistname" type="text_mult" indexed="true" stored="false" multiValued="true" />
  <field name="creditname" type="text_mult" indexed="true" stored="false" multiValued="true" />
  <field name="artist_credit_json" type="storefield" indexed="false" stored="true" />

  <!-- search-only: convert_release_group never emitted an alias list -->
  <field name="alias" type="text_mult" indexed="true" stored="false" multiValued="true" />

  <field name="firstreleasedate" type="date" indexed="true" stored="true" />

  <field name="primarytype" type="lowercase" indexed="true" stored="true" />
  <field name="primarytype_gid" type="mbid" indexed="false" stored="true" />
  <!-- paired positionally, like tag/tag_count -->
  <field name="secondarytype" type="lowercase_mult" indexed="true" stored="true" multiValued="true" />
  <field name="secondarytype_gid" type="mbid" indexed="false" stored="true" multiValued="true" />
  <!-- calculate_type(): first matching secondary type when primary is Album, else primary -->
  <field name="calc_type" type="string" indexed="false" stored="true" />
  <field name="calc_type_gid" type="mbid" indexed="false" stored="true" />

  <field name="release" type="text_mult" indexed="true" stored="false" multiValued="true" />
  <field name="reid" type="mbid" indexed="true" stored="false" multiValued="true" />
  <field name="status" type="lowercase_mult" indexed="true" stored="false" multiValued="true" omitNorms="true" />
  <field name="release_json" type="storefield" indexed="false" stored="true" multiValued="true" />
  <field name="releases" type="int" indexed="true" stored="false" />

  <field name="tag" type="text_mult" indexed="true" stored="true" multiValued="true" />
  <field name="tag_count" type="int" indexed="false" stored="true" multiValued="true" />

  <field name="mbid" type="mbid" indexed="true" stored="true" required="true" />
  <field name="edge-ngram" type="edge-ngram" indexed="true" stored="false" multiValued="true" />
  <field name="rgid" type="mbid" indexed="true" stored="false" />
  <field name="type" type="lowercase_mult" indexed="true" stored="false" multiValued="true" omitNorms="true" />
  <!-- If you remove this field, you must _also_ disable the update log in solrconfig.xml
     or Solr won't start. _version_ and update log are required for SolrCloud. -->
  <field name="_version_" type="long" indexed="true" stored="true" />
  <copyField source="mbid" dest="rgid" />
  <copyField source="releasegroup" dest="releasegroupaccent" />
  <copyField source="primarytype" dest="type" />
  <copyField source="secondarytype" dest="type" />
  <copyField source="releasegroup" dest="edge-ngram" />
  <!-- field to use to determine and enforce document uniqueness. -->
  <uniqueKey>mbid</uniqueKey>
</schema>
